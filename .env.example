# Copy to `.env` (gitignored) and fill in. All variables are optional and
# layer on top of `config/default.toml` and `config/{HL_ENV}.toml`.

# --- Execution ---------------------------------------------------------------
# observe | simulate | live   (live requires HL_LIVE_CONFIRM=YES)
HL_MODE=observe
# mainnet | testnet
HL_NETWORK=mainnet
# auto | confirm   (auto = engine trades on its own)
HL_AUTONOMY=auto
# Selects config/{HL_ENV}.toml (default: "default")
HL_ENV=default

# Live-trading gate: must be YES for mode=live
HL_LIVE_CONFIRM=NO

# --- Secrets (never commit) --------------------------------------------------
# Master account address (required for live)
HL_ACCOUNT_ADDRESS=
# Agent/API wallet private key (required for live; cannot withdraw)
HL_AGENT_PRIVATE_KEY=

# --- Storage & runtime -------------------------------------------------------
HL_DB_PATH=data/hlbot.db
HL_SCHEDULE_CANCEL_TTL_MS=30000
HL_HTTP_PORT=9090

# Note: the watchlist is a list, so set it in config/default.toml or pass
# `--coins BTC,ETH,SOL` on the command line rather than via an env var.
